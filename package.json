{
    "name": "@chirpwireless/ui-kit",
    "version": "1.0.0",
    "type": "module",
    "declaration": true,
    "main": "dist/index.cjs.js",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.cjs.js"
        },
        "./theme": {
            "types": "./dist/theme/index.d.ts",
            "import": "./dist/theme/index.es.js",
            "require": "./dist/theme/index.cjs.js"
        },
        "./theme/augmentation": {
            "types": "./dist/theme/augmentation.d.ts",
            "import": "./dist/theme/augmentation.es.js",
            "require": "./dist/theme/augmentation.cjs.js"
        },
        "./icons": {
            "types": "./dist/icons/index.d.ts",
            "import": "./dist/icons/index.es.js",
            "require": "./dist/icons/index.cjs.js"
        },
        "./layouts": {
            "types": "./dist/layouts/index.d.ts",
            "import": "./dist/layouts/index.es.js",
            "require": "./dist/layouts/index.cjs.js"
        },
        "./shell": {
            "types": "./dist/shell.d.ts",
            "import": "./dist/shell.es.js",
            "require": "./dist/shell.cjs.js"
        },
        "./primitives": {
            "types": "./dist/primitives.d.ts",
            "import": "./dist/primitives.es.js",
            "require": "./dist/primitives.cjs.js"
        },
        "./locales": {
            "types": "./dist/locales/resources/index.d.ts",
            "import": "./dist/locales/resources/index.es.js",
            "require": "./dist/locales/resources/index.cjs.js"
        },
        "./styles.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "repository": "https://github.com/chirpwireless/ui-kit.git",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "dev": "storybook dev -p 6006 --no-open",
        "build": "vite build",
        "build:css": "sass src/styles/style.scss dist/style.css",
        "dev:open": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "eslint . --ext ts,tsx --max-warnings 0 && stylelint \"**/*.scss\"",
        "lint:fix": "eslint . --ext ts,tsx --fix --max-warnings 0 --no-ignore",
        "lint:scss:fix": "npx stylelint \"**/*.scss\" --fix",
        "publish-ui": "npm publish",
        "build-and-pack": "yarn build && yarn pack"
    },
    "peerDependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mapbox/mapbox-gl-draw": "^1.5.0",
        "@mapbox/mapbox-gl-geocoder": "^5.0.3",
        "@mapbox/mapbox-gl-language": "^1.0.1",
        "@mapbox/mapbox-sdk": "^0.16.1",
        "@mui/icons-material": "^9.0.0",
        "@mui/material": "^9.0.0",
        "@tanstack/react-table": "^8.20.6",
        "@tanstack/react-virtual": "^3.10.7",
        "@turf/bbox": "^7.1.0",
        "@turf/bearing": "^7.2.0",
        "@turf/centroid": "^7.1.0",
        "@turf/circle": "^7.1.0",
        "@turf/distance": "^7.1.0",
        "date-fns": "^4.4.0",
        "i18next": "^26.5.5",
        "mapbox-gl": "^3.9.3",
        "mapbox-gl-draw-geodesic": "^2.3.1",
        "moment": "^2.30.1",
        "mui-tel-input": "^11.0.0",
        "react": "^19.0.0",
        "react-date-range": "^2.0.1",
        "react-dom": "^19.0.0",
        "react-dropzone": "^20.1.4",
        "react-i18next": "^17.1.2",
        "react-imask": "^7.6.1",
        "react-router-dom": "^7.18.4",
        "react-toastify": "^11.1.0"
    },
    "devDependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/compat": "^2.1.1",

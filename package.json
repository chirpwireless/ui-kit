        "react-imask": "^7.6.1",
        "react-router-dom": "^7.18.4",
        "react-toastify": "^11.1.0",
        "sass": "^1.106.1",
        "storybook": "10.6.3",
        "stylelint": "^17.16.0",
        "stylelint-config-prettier-scss": "^1.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-dts": "^5.1.2",
        "vite-plugin-svgr": "^5.2.0"
    },
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "dependencies": {}
}

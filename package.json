        "@stylistic/eslint-plugin": "^5.10.0",
        "@tanstack/react-table": "^8.20.6",
        "@tanstack/react-virtual": "^3.14.22",
        "@turf/bbox": "^7.4.0",
        "@turf/bearing": "^7.4.0",
        "@turf/centroid": "^7.4.0",
        "@turf/circle": "^7.4.0",
        "@turf/distance": "^7.4.0",
        "@types/mapbox__mapbox-gl-draw": "^1.4.9",
        "@types/mapbox__mapbox-gl-geocoder": "^5.1.2",

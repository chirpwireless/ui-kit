{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "declaration": true,
        "outDir": "./dist",
        "emitDeclarationOnly": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": false,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "types": ["node", "@types/mapbox__mapbox-sdk", "vite/client"],
        "paths": {
            "@chirp/ui/*": ["./src/*"]
        }
    },
    "include": ["src/**/*", "./src", "./vite.config.ts", ".storybook/*", "src/styles/theme.d.ts"],
    "exclude": ["node_modules"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
